#!/bin/bash
# Pre-commit hook: Runs sortimports and lint on staged files
# Install with: make init-hooks

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit hooks...${NC}"

# Get the repository root directory
REPO_ROOT=$(git rev-parse --show-toplevel)

# Get staged TypeScript/JavaScript files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}No TypeScript/JavaScript files staged. Skipping lint checks.${NC}"
    exit 0
fi

echo -e "${YELLOW}Staged files:${NC}"
echo "$STAGED_FILES"
echo ""

# Check if Docker is available
if ! command -v docker &> /dev/null; then
    echo -e "${RED}Error: Docker is not available. Please install Docker or skip hooks with --no-verify${NC}"
    exit 1
fi

# Check if docker compose is running
if ! docker compose ps --quiet 2>/dev/null | head -1 > /dev/null; then
    echo -e "${YELLOW}Docker containers are not running. Starting them...${NC}"
    docker compose up -d
    sleep 2
fi

# Run sortimports on staged files
echo -e "${YELLOW}Running sort:imports...${NC}"
docker compose exec -T frontend npm run sort:imports -- $STAGED_FILES 2>/dev/null || {
    # Fallback: run on all files if specific file targeting fails
    docker compose exec -T frontend npm run sort:imports
}

# Re-add files that were modified by sortimports
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        git add "$file"
    fi
done

# Run lint on staged files
echo -e "${YELLOW}Running lint...${NC}"
docker compose exec -T frontend npm run lint -- --fix $STAGED_FILES 2>/dev/null || {
    # Fallback: run lint check on all files
    docker compose exec -T frontend npm run lint
}

# Re-add files that were modified by lint fix
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        git add "$file"
    fi
done

echo -e "${GREEN}Pre-commit hooks completed successfully!${NC}"
