@startuml ToggleRuleActive

title ルールトグル機能 シーケンス図

box "Rules Page - UI" #LightBlue
  participant "ToggleSwitch" as UI
  participant "RulesApp" as View
end box

box "interface-adapters" #LightGreen
  participant "<<interface>>\nIToggleRuleActiveControllerFactory" as IFactory
  participant "ToggleRuleActiveControllerFactory" as Factory
  participant "<<interface>>\nIToggleRuleActiveController" as IController
  participant "ToggleRuleActiveController" as Controller
  participant "ToggleRuleActivePresenter" as Presenter
  participant "RewriteRuleMapper" as Mapper
  participant "<<interface>>\nIRewriteRuleMessagingPort" as IMessagingPort
end box

box "application-business-rules" #LightYellow
  participant "ToggleRuleActiveInteractor" as Interactor
  participant "<<interface>>\nIRewriteRuleRepository" as IRepository
  participant "<<interface>>\nITabsGateway" as ITabsGateway
end box

box "frameworks-and-drivers" #LightCyan
  participant "ChromeRuntimeRewriteRuleRepository" as MessagingRepo
  participant "ChromeTabsGateway" as TabsGateway
  participant "RewriteRuleMessagingService" as MessagingService
  participant "<<interface>>\nIRewriteRuleProxyService" as IProxyService
end box

box "Background" #LightGray
  participant "RewriteRuleProxyService" as ProxyService
  participant "RewriteRuleProxyServiceImpl" as ProxyServiceImpl
  participant "DexieRewriteRuleRepository" as DexieRepo
end box

box "enterprise-business-rules" #LightPink
  participant "RewriteRule" as Entity
end box

== 初期化（useMemo内） ==

View -> IFactory : create(onSuccess, onError)
activate IFactory

IFactory -> Factory : create(onSuccess, onError)
activate Factory

Factory -> Presenter : new(onSuccess, onError)
Factory -> Interactor : new(repository, tabsGateway, presenter)
Factory -> Controller : new(interactor)
Factory --> IFactory : controller
deactivate Factory

IFactory --> View : controller
deactivate IFactory

note right of View
  ADR-005: Factoryパターンにより
  ReactコールバックをPresenterに注入
end note

== トグル操作 ==

UI -> View : onToggle(ruleId)
activate View

View -> IController : toggleActive(ruleId)
activate IController

IController -> Controller : toggleActive(ruleId)
activate Controller

Controller -> Interactor : execute(inputData)
activate Interactor

Interactor -> IRepository : getById(ruleId)
activate IRepository

IRepository -> MessagingRepo : getById(ruleId)
activate MessagingRepo

MessagingRepo -> Mapper : getById(ruleId)
activate Mapper

Mapper -> IMessagingPort : getById(dto)
activate IMessagingPort

IMessagingPort -> MessagingService : getById(dto)
activate MessagingService

MessagingService -> IProxyService : getById(dto)
activate IProxyService

IProxyService -> ProxyService : getById(dto)
activate ProxyService

ProxyService -> ProxyServiceImpl : getById(dto)
activate ProxyServiceImpl

ProxyServiceImpl -> DexieRepo : getById(ruleId)
activate DexieRepo
DexieRepo --> ProxyServiceImpl : DTO
deactivate DexieRepo

ProxyServiceImpl --> ProxyService : DTO
deactivate ProxyServiceImpl

ProxyService --> IProxyService : DTO
deactivate ProxyService

IProxyService --> MessagingService : DTO
deactivate IProxyService

MessagingService --> IMessagingPort : DTO
deactivate MessagingService

IMessagingPort --> Mapper : DTO
deactivate IMessagingPort

Mapper -> Entity : new(...)
Entity --> Mapper : rule

Mapper --> MessagingRepo : rule
deactivate Mapper

MessagingRepo --> IRepository : rule
deactivate MessagingRepo

IRepository --> Interactor : rule
deactivate IRepository

Interactor -> Entity : withActive(!isActive)
Entity --> Interactor : updatedRule

Interactor -> IRepository : update(updatedRule)
activate IRepository

IRepository -> MessagingRepo : update(updatedRule)
activate MessagingRepo

MessagingRepo -> Mapper : update(updatedRule)
activate Mapper

Mapper -> IMessagingPort : updateActive(dto)
activate IMessagingPort

IMessagingPort -> MessagingService : updateActive(dto)
activate MessagingService

MessagingService -> IProxyService : updateActive(dto)
activate IProxyService

IProxyService -> ProxyService : updateActive(dto)
activate ProxyService

ProxyService -> ProxyServiceImpl : updateActive(dto)
activate ProxyServiceImpl

ProxyServiceImpl -> DexieRepo : updateActive(dto)
activate DexieRepo
DexieRepo --> ProxyServiceImpl : void
deactivate DexieRepo

ProxyServiceImpl --> ProxyService : void
deactivate ProxyServiceImpl

ProxyService --> IProxyService : void
deactivate ProxyService

IProxyService --> MessagingService : void
deactivate IProxyService

MessagingService --> IMessagingPort : void
deactivate MessagingService

IMessagingPort --> Mapper : void
deactivate IMessagingPort

Mapper --> MessagingRepo : void
deactivate Mapper

MessagingRepo --> IRepository : void
deactivate MessagingRepo

IRepository --> Interactor : void
deactivate IRepository

Interactor -> ITabsGateway : reloadMatchingTabs(rule)
activate ITabsGateway

ITabsGateway -> TabsGateway : reloadMatchingTabs(rule)
activate TabsGateway

loop 各タブ
  TabsGateway -> Entity : matchesUrl(url)
  Entity --> TabsGateway : boolean
end

TabsGateway --> ITabsGateway : void
deactivate TabsGateway

ITabsGateway --> Interactor : void
deactivate ITabsGateway

Interactor -> Presenter : present(outputData)
activate Presenter

Presenter -> View : updateRuleInView(rule)
View --> UI : 状態更新

deactivate Presenter
deactivate Interactor
deactivate Controller
deactivate IController
deactivate View

== エラーケース ==

note over Interactor, Presenter
  エラー発生時のフロー
  - ルール取得失敗: UIは変更なし
  - ルール更新失敗: UIは変更なし
  - タブリロード失敗: UIはトグル後の状態を表示（部分的成功）
end note

alt ルール取得失敗 または ルール更新失敗
  Interactor -> Presenter : presentError(errorOutputData)
  activate Presenter
  note right of Presenter
    ToggleRuleActiveErrorOutputData を使用
    - ruleId: number
    - message: string
  end note
  Presenter -> View : showErrorInView(ruleId, message)
  View --> UI : エラーメッセージ表示（状態変更なし）
  deactivate Presenter

else タブリロード失敗（部分的成功）
  note over Interactor
    DB更新は成功済み
    presenter.present() 呼び出し後に
    タブリロードでエラー発生
  end note
  Interactor -> Presenter : present(outputData)
  activate Presenter
  Presenter -> View : updateRuleInView(rule)
  View --> UI : 状態更新（トグル後の状態）
  deactivate Presenter

  Interactor -> Presenter : presentError(errorOutputData)
  activate Presenter
  Presenter -> View : showErrorInView(ruleId, message)
  View --> UI : エラーメッセージ表示
  deactivate Presenter
end

@enduml
