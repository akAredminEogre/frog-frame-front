' docs/docs-rules/design.mdの記述に従うこと
@startuml ToggleRuleActiveClassDiagram

skinparam packageStyle rectangle

' ===================================================
' レイアウト方針（docs/docs-rules/design.md に準拠）:
' 図を縦に2分割:
'   左1列目: Controller, Presenter, View
'   左2列目: upper row（3列）+ lower row（DataAccess）
' ===================================================

' ===== 左1列目: Controller, Presenter, View =====
package "left first column" as LeftCol1 {
  class ToggleRuleActiveController <<Controller>> {
    - useCase: IToggleRuleActiveUseCase
    + toggleActive(ruleId: number): Promise<void>
  }

  class ToggleRuleActivePresenter <<Presenter>> {
    - updateRuleInView: (rule: RewriteRule) => void
    + present(outputData: ToggleRuleActiveOutputData): void
  }

  class RulesApp <<View>> {
    + onToggle(ruleId: number): void
  }

  ToggleRuleActiveController -[hidden]d- ToggleRuleActivePresenter
  ToggleRuleActivePresenter -[hidden]d- RulesApp
}

' ===== 左2列目 =====
package "left second column" as LeftCol2 {

  ' --- 上1行目: 3列構成 ---
  package "left second column upper row" as UpperRow {

    ' 1列目: UseCase抽象, Presenter抽象, OutputData
    package "left second column upper row first column" as URCol1 {
      interface IToggleRuleActiveUseCase <<Input Port>> {
        + execute(inputData: ToggleRuleActiveInputData): Promise<void>
      }

      interface IToggleRuleActivePresenter <<Output Port>> {
        + present(outputData: ToggleRuleActiveOutputData): void
      }

      class ToggleRuleActiveOutputData <<Output Data>> {
        + toggledRule: RewriteRule
      }

      IToggleRuleActiveUseCase -[hidden]d- IToggleRuleActivePresenter
      IToggleRuleActivePresenter -[hidden]d- ToggleRuleActiveOutputData
    }

    ' 2列目: InputData, Interactor, Repository抽象, Repository具象
    package "left second column upper row second column" as URCol2 {
      class ToggleRuleActiveInputData <<Input Data>> {
        + ruleId: number
      }

      class ToggleRuleActiveInteractor <<Use Case>> {
        - repository: IRewriteRuleRepository
        - tabsGateway: ITabsGateway
        - presenter: IToggleRuleActivePresenter
        + execute(inputData: ToggleRuleActiveInputData): Promise<void>
      }

      interface IRewriteRuleRepository <<Gateway Interface>> {
        + getById(id: number): Promise<RewriteRule>
        + update(rule: RewriteRule): Promise<void>
      }

      class ChromeRuntimeRewriteRuleRepository <<Repository>> {
        - mapper: RewriteRuleMapper
        + getById(id: number): Promise<RewriteRule>
        + update(rule: RewriteRule): Promise<void>
      }

      ToggleRuleActiveInputData -[hidden]d- ToggleRuleActiveInteractor
      ToggleRuleActiveInteractor -[hidden]d- IRewriteRuleRepository
      IRewriteRuleRepository -[hidden]d- ChromeRuntimeRewriteRuleRepository
    }

    ' 3列目: Gateway抽象, Gateway具象, Entity, Mapper
    package "left second column upper row third column" as URCol3 {
      interface ITabsGateway <<Gateway Interface>> {
        + reloadMatchingTabs(rule: RewriteRule): Promise<void>
      }

      class ChromeTabsGateway <<Gateway>> {
        + reloadMatchingTabs(rule: RewriteRule): Promise<void>
      }

      class RewriteRule <<Entity>> {
        - id: RuleId
        - urlPattern: UrlPattern
        - isActive: boolean
        + withActive(isActive: boolean): RewriteRule
        + matchesUrl(url: string): boolean
      }

      class RewriteRuleMapper <<Mapper>> {
        - messagingPort: IRewriteRuleMessagingPort
        + getById(id: number): Promise<RewriteRule>
        + update(rule: RewriteRule): Promise<void>
      }

      ITabsGateway -[hidden]d- ChromeTabsGateway
      ChromeTabsGateway -[hidden]d- RewriteRule
      RewriteRule -[hidden]d- RewriteRuleMapper
    }

    URCol1 -[hidden]r- URCol2
    URCol2 -[hidden]r- URCol3
  }

  ' --- 下2行目: DataAccess ---
  package "left second column lower row" as LowerRow {
    rectangle "RewriteRule DataAccess" as DataAccess #LightCyan {

      ' データアクセス上1行目: Messaging具象, Messaging抽象
      package "data access upper row" as DAUpperRow {
        class RewriteRuleMessagingService <<Messaging Service>> {
          + getById(dto: GetByIdRequestDTO): Promise<RewriteRuleDTO>
          + updateActive(dto: UpdateRuleActiveRequestDTO): Promise<void>
        }

        interface IRewriteRuleMessagingPort <<Port>> {
          + getById(dto: GetByIdRequestDTO): Promise<RewriteRuleDTO>
          + updateActive(dto: UpdateRuleActiveRequestDTO): Promise<void>
        }

        RewriteRuleMessagingService -[hidden]r- IRewriteRuleMessagingPort
      }

      ' データアクセス下2行目: DB Repository, DTO
      package "data access lower row" as DALowerRow {
        class DexieRewriteRuleRepository <<Repository>> {
          + getById(id: number): Promise<RewriteRuleDTO>
          + updateActive(dto: UpdateRuleActiveRequestDTO): Promise<void>
        }

        class RewriteRuleDTO <<DTO>> {
          + id: number
          + urlPattern: string
          + isActive: boolean
        }

        class GetByIdRequestDTO <<DTO>> {
          + id: number
        }

        class UpdateRuleActiveRequestDTO <<DTO>> {
          + id: number
          + isActive: boolean
        }

        DexieRewriteRuleRepository -[hidden]r- RewriteRuleDTO
        RewriteRuleDTO -[hidden]r- GetByIdRequestDTO
        GetByIdRequestDTO -[hidden]r- UpdateRuleActiveRequestDTO
      }

      DAUpperRow -[hidden]d- DALowerRow
    }
  }

  UpperRow -[hidden]d- LowerRow
}

' 左1列目 → 左2列目の配置
LeftCol1 -[hidden]r- LeftCol2

' ===== 関連 =====

' 左1列目内部
RulesApp ....> ToggleRuleActiveController : uses
ToggleRuleActivePresenter ....> RulesApp : updates

' 左1列目 → 上1行目1列目
ToggleRuleActiveController ....> IToggleRuleActiveUseCase : uses
ToggleRuleActivePresenter ....|> IToggleRuleActivePresenter : implements

' 上1行目1列目 → 上1行目2列目
ToggleRuleActiveInteractor ....|> IToggleRuleActiveUseCase : implements
ToggleRuleActiveInteractor ....> IToggleRuleActivePresenter : uses
ToggleRuleActiveInteractor ....> IRewriteRuleRepository : uses
ToggleRuleActiveInteractor ....> ToggleRuleActiveInputData : uses
ToggleRuleActiveInteractor ....> ToggleRuleActiveOutputData : creates

' 上1行目2列目内部
ChromeRuntimeRewriteRuleRepository ....|> IRewriteRuleRepository : implements

' 上1行目2列目 → 上1行目3列目
ToggleRuleActiveInteractor ....> ITabsGateway : uses
ToggleRuleActiveInteractor ....> RewriteRule : uses
ChromeRuntimeRewriteRuleRepository ....> RewriteRuleMapper : delegates

' 上1行目3列目内部
ChromeTabsGateway ....|> ITabsGateway : implements
ChromeTabsGateway ....> RewriteRule : calls matchesUrl()
RewriteRuleMapper ....> RewriteRule : creates

' 上1行目3列目 → DataAccess（下方向を明示）
RewriteRuleMapper ....d> IRewriteRuleMessagingPort : uses

' DataAccess上1行目内部
RewriteRuleMessagingService ....|> IRewriteRuleMessagingPort : implements

' DataAccess上1行目 → DataAccess下2行目（下方向を明示）
RewriteRuleMessagingService ....d> DexieRewriteRuleRepository : delegates
RewriteRuleMapper ....d> GetByIdRequestDTO : creates
RewriteRuleMapper ....d> UpdateRuleActiveRequestDTO : creates
RewriteRuleMapper ....d> RewriteRuleDTO : converts
RewriteRuleMessagingService ....> GetByIdRequestDTO : receives
RewriteRuleMessagingService ....> UpdateRuleActiveRequestDTO : receives
RewriteRuleMessagingService ....> RewriteRuleDTO : returns

@enduml
