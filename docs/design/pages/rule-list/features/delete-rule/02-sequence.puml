@startuml DeleteRule

title ルール削除機能 シーケンス図

box "UI" #LightBlue
  participant "RulesApp" as View
  participant "ConfirmDialog" as Dialog
end box

box "interface-adapters" #LightGreen
  participant "IDeleteRuleController\nFactory" as IFactory
  participant "DeleteRule\nController" as Controller
  participant "DeleteRule\nPresenter" as Presenter
end box

box "application" #LightYellow
  participant "DeleteRule\nInteractor" as Interactor
  participant "IRewriteRule\nRepository" as IRepository
  participant "ITabsGateway" as ITabsGateway
end box

box "frameworks" #LightCyan
  participant "RewriteRule\nMessagingService" as MessagingService
end box

box "Background" #LightGray
  participant "DexieRewriteRule\nRepository" as DexieRepo
end box

box "domain" #LightPink
  participant "RewriteRule" as Entity
end box

== 初期化 ==

View -> IFactory : create(onSuccess, onError)
IFactory --> View : controller
note right: ADR-005: Factory パターン

== 削除フロー ==

View -> Dialog : show("削除しますか？")
alt キャンセル
  Dialog --> View : onCancel()
end

Dialog --> View : onConfirm()
View -> View : deletingIds.add(ruleId)

View -> Controller : deleteRule(ruleId)
Controller -> Interactor : execute(inputData)

Interactor -> IRepository : getById(ruleId)
IRepository -> MessagingService : getById(dto)
MessagingService -> DexieRepo : getById(ruleId)
DexieRepo --> MessagingService : DTO
MessagingService --> IRepository : rule
IRepository --> Interactor : rule

Interactor -> IRepository : delete(ruleId)
IRepository -> MessagingService : delete(dto)
MessagingService -> DexieRepo : delete(ruleId)
DexieRepo --> MessagingService : void
MessagingService --> IRepository : void
IRepository --> Interactor : void

Interactor -> ITabsGateway : reloadMatchingTabs(rule)
loop 各タブ
  ITabsGateway -> Entity : matchesUrl(url)
end
ITabsGateway --> Interactor : void

Interactor -> Presenter : present(outputData)
Presenter -> View : removeRuleFromView(deletedRuleId)
View -> View : deletingIds.delete(ruleId)

== エラー時 ==

alt 削除失敗
  Interactor -> Presenter : presentError(errorOutputData)
  Presenter -> View : showErrorInView(message)
  note right: Toast通知表示
  View -> View : deletingIds.delete(ruleId)
else タブリロード失敗（部分的成功）
  Interactor -> Presenter : present(outputData)
  Interactor -> Presenter : presentError(errorOutputData)
  View -> View : deletingIds.delete(ruleId)
end

@enduml
